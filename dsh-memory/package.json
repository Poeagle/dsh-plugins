{
  "name": "dsh-memory",
  "version": "0.2.1",
  "description": "Bounded curated memory with frozen system-prompt snapshots, threat scanning, and a post-turn background review fork.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./settings": "./lib/settings.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "file:../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-atomic-write": "file:../../deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-home-paths": "file:../../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "file:../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "file:../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-system-prompt": "file:../../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-util-values": "file:../../deepseek-harness/packages/util/values",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "memory"
  ]
}
